# n8n General Configuration
# Cloud Run dynamically assigns the port via PORT variable, but n8n expects N8N_PORT.
# We set it in the Dockerfile to 8080.
# N8N_PORT=8080
# N8N_LISTEN_ADDRESS=0.0.0.0

# Database Configuration (External PostgreSQL, e.g., Neon or Supabase)
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_HOST=your-db-host.supabase.co
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=your_secure_password

# Optional: Disable SSL if using a local network (not recommended for Neon/Supabase).
# For managed databases over the internet, SSL should be enabled (often required).
# DB_POSTGRESDB_SSL=true

# Security & Encryption
# Must be generated securely (e.g., using `openssl rand -hex 16`).
# Critical for stateless deployments so n8n can decrypt saved credentials.
N8N_ENCRYPTION_KEY=generate_a_secure_random_string_here

# Webhook URLs
# This is required so that OAuth callbacks and Webhook nodes generate correct public URLs.
# In Cloud Run, it's the generated service URL. The deploy script will update this.
WEBHOOK_URL=https://your-cloud-run-service-url.a.run.app

# Execution Data Management (Pruning)
# Prevent the external database from growing too large by deleting old execution logs.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168 # 7 days (in hours)

# Disable basic auth, modern n8n uses its own user management system in the DB
# N8N_BASIC_AUTH_ACTIVE=false
